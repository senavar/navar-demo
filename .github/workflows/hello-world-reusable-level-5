name: Hello World Reusable Level 5

on:
  workflow_call:
    inputs:
      who:
        required: true
        type: string
      breadcrumb:
        required: true
        type: string
    outputs:
      final_message:
        description: Final message returned from the deepest reusable workflow.
        value: ${{ jobs.announce.outputs.final_message }}
  
jobs:
  announce:
    name: Level 5 says hello
    runs-on: ubuntu-latest
    outputs:
      final_message: ${{ steps.final-message.outputs.value }}
    steps:
      - name: Print level 5 message
        run: echo "Hello from reusable workflow level 5 for ${{ inputs.who }}."
      
      - name: Process PR data
        run: echo "${{ github.event.pull_request.body }}" > data.txt

      - name: Build final message
        id: final-message
        run: |
          echo "value=Final hello to ${{ inputs.who }} from level 5. Path: ${{ inputs.breadcrumb }} -> level-5" >> "$GITHUB_OUTPUT"
