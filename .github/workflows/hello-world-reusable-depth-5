name: Hello World Reusable Workflow Demo

on:
  workflow_dispatch:
    inputs:
      who:
        description: Who should the workflow greet?
        required: false
        default: customer
        type: string
    
  pull_request:
    types: [opened, edited]

jobs:
  call-level-1:
    name: Call reusable workflow level 1
    uses: ./.github/workflows/hello-world-reusable-level-1.yml
    with:
      who: ${{ inputs.who }}
      breadcrumb: top-level

  show-result:
    name: Show final result
    runs-on: ubuntu-latest
    needs: call-level-1
    steps:
      - name: Print final message
        run: |
          echo "Workflow chain complete."
          echo "${{ needs.call-level-1.outputs.final_message }}"
